# Frontend Impressum data rendered into the static legal page via envsubst at startup
IMPRINT_NAME=Your Name
IMPRINT_STREET=Your Street 123
IMPRINT_CITY_ZIP=12345 Your City
IMPRINT_PHONE=+49 123 456789

# Frontend environment variables passed into Vite build via Docker ARGs (synced with .env.shared)
VITE_MAX_MESSAGES_PER_SESSION=8
VITE_MAX_CHAT_MESSAGE_LENGTH=2000
