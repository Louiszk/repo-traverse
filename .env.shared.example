# Copy this file to .env.shared (`cp .env.shared.example .env.shared`) and adjust values as needed.

# =====================================================================
# 1. Runtime Environment
# =====================================================================
# Application environment mode ('development', 'staging', 'production')
ENVIRONMENT=development

# Logging level ('DEBUG', 'INFO', 'WARNING', 'ERROR')
LOG_LEVEL=INFO

# Backend server host and port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Comma-separated list of allowed CORS origins
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://127.0.0.1,http://127.0.0.1:5173

# Enforce HTTPS-only cookie transmission (Must be set to 'true' in production; 'false' in local dev HTTP)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_COOKIE_NAME=session_secret

# =====================================================================
# 2. Container Image Versioning (Docker Compose)
# =====================================================================
# Explicit container image tags for reproducible production builds and CI/CD
BACKEND_IMAGE=repotraverse-backend:1.0.0
FRONTEND_IMAGE=repotraverse-frontend:1.0.0

# =====================================================================
# 3. Redis / Celery Configuration
# =====================================================================
# Redis authentication password (REQUIRED — docker-compose will refuse to start without it)
REDIS_PASSWORD=changeme_in_production

# Shared data volume mount points
SHARED_DATA_DIR=/app/data
SCRATCH_DATA_DIR=/app/data/scratch

# Subprocess timeout limits for the Celery indexing task (seconds)
CLONE_TIMEOUT_SECONDS=120
INDEX_TIMEOUT_SECONDS=300

# Resource Limits
WORKER_CPU_LIMIT=1.5
WORKER_MEMORY_LIMIT=2G
WORKER_SCRATCH_SIZE=750M
MAX_REPO_SIZE_MB=200
MAX_GRAPH_DB_SIZE_MB=250
REPO_MAX_AGE_SECONDS=7200
REPO_STORAGE_THRESHOLD_GB=10.0
REPO_CLEANUP_INTERVAL_SECONDS=300
TRACES_MAX_AGE_SECONDS=5184000
TRACES_STORAGE_THRESHOLD_GB=1.0

# Rate Limits
MAX_DAILY_BUDGET_DOLLARS=0.40
MAX_DAILY_GLOBAL_INDEXES=20
MAX_DAILY_IP_INDEXES=4
MAX_DAILY_DEVICE_SESSIONS=4
MAX_MESSAGES_PER_SESSION=8
MAX_CONCURRENT_INDEXING_TASKS=2
MAX_CHAT_MESSAGE_LENGTH=2000

# =====================================================================
# 4. Model Settings
# =====================================================================
# LLM Model choice
LLM_MODEL=gpt-5.6-luna
MODERATION_MODEL=omni-moderation-latest
MODERATION_ENABLED=true
MODERATION_FAIL_OPEN=true
MODERATION_TIMEOUT_SECONDS=5.0
TOKENIZER_ENCODING=o200k_base
AGENT_MAX_TOOL_CALLS=6
MAX_CONTEXT_TOKENS=1000000
MAX_COMPLETION_TOKENS=20000
REASONING_EFFORT=low

# LLM pricing per 1M tokens (USD)
COST_INPUT_TOKENS=0.20
COST_CACHED_INPUT_TOKENS=0.02
COST_OUTPUT_TOKENS=1.20
